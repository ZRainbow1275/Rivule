{
  "name": "rivule-qq-gateway",
  "main": "../dist/gateway/worker.mjs",
  "no_bundle": true,
  "compatibility_date": "2026-10-11",
  "vars": {
    "APPLICATION_ID": "REPLACE_APPLICATION_ID",
    "DM_CHANNEL_ID": "REPLACE_DM_CHANNEL_ID",
    "OWNER_DISCORD_ID": "REPLACE_OWNER_DISCORD_ID",
    "OWNER_ID": "REPLACE_OWNER_ID",
    "QQ_ALLOWED_PROJECT_IDS": "[]",
    "QQ_ALLOWED_SOURCE_IDS": "[]",
    "QQ_APP_ID": "REPLACE_QQ_APP_ID",
    "QQ_CAPABILITIES_JSON": "{}",
    "QQ_DAILY_ACTIVE_BUDGET_MS": "7200000",
    "QQ_DELIVERY_ENABLED": "false",
    "QQ_ENABLED": "false",
    "QQ_OWNER_ID": "REPLACE_QQ_OWNER_ID",
    "QQ_PROOF_ENABLED": "false",
    "QQ_SETUP_ENABLED": "false"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "QQ_GATEWAY",
        "class_name": "QQGatewayObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "qq-gateway-v1",
      "new_sqlite_classes": [
        "QQGatewayObject"
      ]
    }
  ],
  "find_additional_modules": true,
  "base_dir": "../dist/gateway"
}
