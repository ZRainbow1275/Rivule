{
  "name": "rivule-app-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {"node": ">=24"},
  "scripts": {
    "precheck": "node scripts/source-bundle.mjs",
    "pretest": "node scripts/source-bundle.mjs",
    "predev": "node scripts/source-bundle.mjs",
    "prebuild": "node scripts/source-bundle.mjs",
    "predeploy": "node scripts/source-bundle.mjs",
    "pretest:runtime": "node scripts/source-bundle.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:runtime": "node --import tsx --test tests/runtime.integration.ts",
    "check": "tsc --noEmit",
    "dev": "wrangler dev --ip 127.0.0.1 --port 8791 --var PUBLIC_ORIGIN:http://127.0.0.1:8791",
    "build": "wrangler deploy --dry-run --minify --outdir dist",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.2.3",
    "@modelcontextprotocol/server": "2.3.0",
    "@modelcontextprotocol/client": "2.3.0",
    "jose": "6.2.12",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261011.1",
    "@types/node": "24.10.0",
    "typescript": "6.0.3",
    "tsx": "4.21.0",
    "wrangler": "4.149.0"
  },
  "license": "AGPL-3.0-only"
}
